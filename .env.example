# Root shared environment hints
# Copy this file to .env and also configure per-service files:
# - apps/web/.env.local
# - services/api/.env

# Frontend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PLAID_ENV=sandbox

# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/keystone
REDIS_URL=redis://localhost:6379/0
CLERK_JWKS_URL=
CLERK_ISSUER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
AI_PROVIDER=mock
AI_API_KEY=
FEATURE_AI_GUIDANCE=false
PLAID_SYNC_DAYS=90
