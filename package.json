{
  "name": "keystone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter @keystone/web dev",
    "dev:web": "pnpm --filter @keystone/web dev",
    "build": "pnpm --filter @keystone/web build",
    "lint": "pnpm --filter @keystone/web lint",
    "typecheck": "pnpm --filter @keystone/web typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "api:up": "docker compose up api",
    "worker:up": "docker compose up worker",
    "api:migrate": "docker compose run --rm api uv run alembic upgrade head",
    "api:seed": "docker compose run --rm api uv run python -m app.scripts.seed_demo"
  }
}
